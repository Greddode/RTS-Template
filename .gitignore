# Build output
build/
build-web/

# Our map files also end in .map (the *.map rule above is for C linker output)
!maps/*.map

# Our own JavaScript source (the *.js rule above is for web build output)
!src/**/*.js

# The web page template (the *.html rule above is for web build output)
!web/shell.html

tools/
nope/
marketing/
# make release output
dist/
